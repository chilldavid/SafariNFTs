# Solana cluster: devnet | testnet | mainnet-beta
SOLANA_CLUSTER=devnet

# Custom RPC endpoint (optional - defaults to public cluster URL)
# SOLANA_RPC_URL=https://api.devnet.solana.com

# Option 1: Paste your base58 private key directly (from Phantom "Export Private Key")
# PRIVATE_KEY=your-base58-private-key-here

# Option 2: Path to a Solana keypair JSON file
WALLET_PATH=~/.config/solana/id.json

# NFT Configuration
NFT_NAME=Safari Lion #1
NFT_SYMBOL=SAFARI
NFT_DESCRIPTION=A majestic lion from the Safari NFT collection on Solana.
NFT_IMAGE_URI=https://arweave.net/your-uploaded-image-uri

# Collection (optional - set after running npm run mint:collection)
# COLLECTION_MINT=your-collection-mint-address

# Royalties in basis points (500 = 5%)
SELLER_FEE_BPS=500

# === Batch Mint (10,000 NFT Collection) ===
# Image URIs per tier (upload each tier's image first with: npm run upload -- ./assets/bronze.png)
# BRONZE_IMAGE_URI=https://arweave.net/your-bronze-image
# SILVER_IMAGE_URI=https://arweave.net/your-silver-image
# GOLD_IMAGE_URI=https://arweave.net/your-gold-image

# Delay between mints in ms (default 2000)
# MINT_DELAY_MS=2000

# Project website (optional)
# EXTERNAL_URL=https://your-project-site.com

# === Compressed NFTs (cNFTs) ===
# Merkle tree address (set after running: npm run cnft:tree)
# MERKLE_TREE_ADDRESS=your-merkle-tree-address
